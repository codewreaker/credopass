{
  "name": "corev2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/core-v2/src",
  "projectType": "application",
  "tags": [
    "type:service",
    "scope:api"
  ],
  "targets": {
    "start": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "GIT_COMMIT=$(git rev-parse --short HEAD) uv run fastapi dev src/app/main.py --port 8090",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check .",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --with pyright pyright",
        "cwd": "{projectRoot}"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run corev2:lint",
          "nx run corev2:typecheck",
          "nx run corev2:test"
        ],
        "parallel": false
      }
    }
  }
}
