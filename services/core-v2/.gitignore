# uv-managed virtualenv — recreate with `uv sync`, never commit it
.venv/

# Python bytecode / tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local config. `uv.lock` is NOT ignored — it is committed, same reasoning as
# bun.lock at the repo root: the lockfile is reviewed like any other code.
.env
