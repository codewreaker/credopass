{
  "openapi": "3.1.0",
  "info": {
    "title": "CredoPass API",
    "version": "v1",
    "description": "Attendance platform API. Every capability of CredoPass is reachable here; the web console is a rendering client over these endpoints."
  },
  "servers": [
    {
      "url": "http://localhost/api/v1/core"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase-issued JWT, or a kiosk device token. Get one with: nx run coreservice:token"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "commit"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "db": {
            "type": "boolean"
          },
          "storage": {
            "type": "boolean"
          }
        },
        "required": [
          "db",
          "storage"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "isGuest": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "isGuest"
        ]
      },
      "MeContext": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrgSummary"
            }
          },
          "activeOrganization": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrgSummary"
              },
              {
                "type": [
                  "object",
                  "null"
                ]
              }
            ]
          },
          "membership": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "role",
              "permissions"
            ]
          },
          "needsOnboarding": {
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "organizations",
          "activeOrganization",
          "membership",
          "needsOnboarding"
        ]
      },
      "OrgSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "role"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "Ops"
        ],
        "responses": {
          "200": {
            "description": "The service is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe — real dependency checks",
        "tags": [
          "Ops"
        ],
        "responses": {
          "200": {
            "description": "All dependencies reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unreachable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "The signed-in account",
        "tags": [
          "Identity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "No valid token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/me/context": {
      "get": {
        "summary": "Account, memberships, active org and effective permissions",
        "tags": [
          "Identity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "x-organization-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Bootstrap context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeContext"
                }
              }
            }
          },
          "401": {
            "description": "No valid token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
