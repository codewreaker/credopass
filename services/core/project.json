{
  "name": "coreservice",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/core/src",
  "projectType": "application",
  "tags": [
    "type:service",
    "scope:api"
  ],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun run scripts/setup.ts"
        ],
        "cwd": "{projectRoot}"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_ENV=development PORT=8080 bun --watch --no-clear-screen src/index.ts",
        "cwd": "{projectRoot}"
      }
    },
    "db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/db.ts",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "status": { "command": "bun run scripts/db.ts status" },
        "migrate": { "command": "bun run scripts/db.ts migrate" },
        "reset": { "command": "bun run scripts/db.ts reset" },
        "seed": { "command": "bun run scripts/db.ts seed" }
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/db.ts migrate",
        "cwd": "{projectRoot}"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/db.ts seed",
        "cwd": "{projectRoot}"
      }
    },
    "verify:public-access": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash sql/verify-public-access.sh",
        "cwd": "{projectRoot}"
      }
    },
    "dev:up": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker compose -f ../../docker/docker-compose.dev.yml up -d --wait credopass-postgres credopass-minio",
          "docker compose -f ../../docker/docker-compose.dev.yml up -d credopass-minio-init"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "dev:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f ../../docker/docker-compose.dev.yml --profile test --profile services down",
        "cwd": "{projectRoot}"
      }
    },
    "dev:logs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f ../../docker/docker-compose.dev.yml logs -f",
        "cwd": "{projectRoot}"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run coreservice:lint",
          "nx run coreservice:typecheck",
          "nx run coreservice:test"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test src/test/*.test.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker compose -f ../../docker/docker-compose.dev.yml --profile test up -d --wait credopass-postgres-test",
          "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:55432/credopass_test} bun test src/test/integration"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "test:adversarial": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker compose -f ../../docker/docker-compose.dev.yml --profile test up -d --wait credopass-postgres-test",
          "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:55432/credopass_test} bun test src/test/adversarial"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p .",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "open http://localhost:8080/api/v1/core/docs || echo 'Open http://localhost:8080/api/v1/core/docs'",
        "cwd": "{projectRoot}"
      }
    },
    "token": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/dev-token.ts",
        "cwd": "{projectRoot}"
      }
    },
    "openapi:export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/export-openapi.ts",
        "cwd": "{projectRoot}"
      }
    },
    "studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit studio",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun build ./src/index.ts --outdir ../../dist/{projectRoot} --target bun --env disable",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gcloud run deploy credopass-api --source ../.. --region us-central1",
        "cwd": "{projectRoot}"
      }
    }
  }
}
