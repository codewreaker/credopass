# =============================================================================
# services/core — environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way;
# production secrets belong in GCP Secret Manager, not here
# (docs/API-FIRST-REBUILD.md §9.5).
# =============================================================================

# -----------------------------------------------------------------------------
# The one switch that drives everything (§9.3)
# -----------------------------------------------------------------------------
# local | staging | production
#
# `local` points every dependency at something running on this machine, so a
# developer never needs — and never accidentally gets — credentials for the
# remote instance.
CREDOPASS_ENV=local

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# local  : supabase start        → postgresql://postgres:postgres@localhost:54322/postgres
#          docker compose        → postgresql://postgres:postgres@localhost:5432/credopass_db
# remote : the Supabase project's connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Throwaway database for the test suites. The adversarial suite TRUNCATEs every
# table between runs, so this must NEVER point at a database anyone cares about.
# Unset it and Testcontainers starts its own (requires Docker).
#   docker compose -f docker/docker-compose.dev.yml --profile test up -d
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/credopass_test

# -----------------------------------------------------------------------------
# Identity (§D1)
# -----------------------------------------------------------------------------
# The issuer whose JWKS verifies incoming tokens. Supabase is the only
# configured issuer until a tenant brings their own IdP, at which point that is
# a row in org_identity_providers rather than a change here.
# local: http://localhost:54321
SUPABASE_URL=http://localhost:54321

# AUTH_DISABLED is deliberately absent.
#
# It used to be the only way to develop without reaching the remote Supabase
# project, which made the auth path the LEAST exercised code in local
# development — exactly backwards for the subsystem the rebuild rests on (§9.3).
# `supabase start` gives you real JWTs locally, so the escape hatch is not
# needed. Do not reintroduce it.

# -----------------------------------------------------------------------------
# Storage (§9.1) — MinIO locally, S3 in deployed environments
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=credopass-media-local
S3_ACCESS_KEY_ID=credopass
S3_SECRET_ACCESS_KEY=credopass
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080
# Set by the Nx `start` target. Without it, std-env's `isDevelopment` is false
# and index.ts takes the production CORS branch, which blocks localhost.
NODE_ENV=development

# Geocoding runs server-side from Phase 6 (§10.3), so this token stops shipping
# to the browser at that point.
MAPBOX_AUTOCOMPLETE_TOKEN=

# -----------------------------------------------------------------------------
# Not yet used — land in later phases, listed so the shape is known
# -----------------------------------------------------------------------------
# RESEND_API_KEY=            # Phase 3, transactional email (D18)
# MAIL_FROM=noreply@mail.credopass.com
# PASS_SIGNING_KEY=          # Phase 3, per-org HMAC for attendee passes (D12)
# STRIPE_WEBHOOK_SECRET=     # Phase 6, plan changes (D15)
