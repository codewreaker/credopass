# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.
.env
.env.*
!.env.example

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

**/data/credopass/*
# Migrations are tracked on purpose: every schema change must be reviewable, and
# a migration nobody can read is a migration nobody can audit. See
# docs/API-FIRST-REBUILD.md §9.4. Drizzle's local scratch output stays ignored.
**/drizzle/**/*.timestamp*
vite.config.*.timestamp*
vitest.config.*.timestamp*

# Expo
node_modules/
.expo/
.yarn/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
cache/
audit/*